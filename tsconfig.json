{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/wasm/**/*.d.ts",
    "src/wasm_core/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "target",
    "crates"
  ]
}
