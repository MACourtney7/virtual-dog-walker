{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virtual-dog-walker",
  "main": "party/server.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ParkServer",
        "class_name": "ParkServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ParkServer"]
    }
  ]
}
